<?xml version="1.0" encoding="utf-8"?>
<!-- The companion runs on the LAN over plain HTTP (http://<phone-ip>:8800). A user-entered IP
     can't be listed as a domain, so cleartext is allowed app-wide. See DECISIONS.md. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
