#!/bin/sh
# tileops-read: fixed, read-only views used by TileOps probes via sudo.
# Takes exactly one subcommand and no other input, so the sudoers rule can be exact.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LIMIT=262144
case "${1:-}" in
  crontabs)
    for d in /var/spool/cron/crontabs /var/spool/cron; do
      [ -d "$d" ] || continue
      for f in "$d"/*; do
        [ -f "$f" ] && [ ! -L "$f" ] || continue
        echo "==> $f <=="
        head -c "$LIMIT" "$f"
        echo
      done
    done ;;
  authorized-keys)
    { getent passwd 2>/dev/null || cat /etc/passwd; } | while IFS=: read -r user _ _ _ _ home _; do
      [ -n "$home" ] && [ -d "$home" ] || continue
      for f in "$home/.ssh/authorized_keys" "$home/.ssh/authorized_keys2"; do
        [ -f "$f" ] && [ ! -L "$f" ] || continue
        case "$(readlink -f "$f")" in */authorized_keys|*/authorized_keys2) ;; *) continue ;; esac
        echo "==> $user $f <=="
        head -c "$LIMIT" "$f"
        echo
      done
    done ;;
  *)
    echo "usage: tileops-read crontabs|authorized-keys" >&2; exit 2 ;;
esac
