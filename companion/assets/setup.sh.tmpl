#!/bin/sh
# TileOps server setup for "__NAME__" (generated by the TileOps app or companion).
# Run ONCE as root. It:
#   1. creates the unprivileged user '__USER__' (if missing) with NO password,
#   2. adds TileOps' SSH public key for that user,
#   3. installs /usr/local/sbin/tileops-read (read-only helper: crontabs + authorized_keys),
#   4. writes /etc/sudoers.d/tileops-__USER__ allowing ONLY exact read commands
#      and `systemctl status|restart` for: __SERVICES_HUMAN__
# Safe to run again. Nothing else on the server is changed.
set -eu
U='__USER__'
KEY='__KEY__'
SERVICES='__SERVICES__'

[ "$(id -u)" = 0 ] || { echo "Please run as root (e.g. with sudo)." >&2; exit 1; }

CREATED=0
if ! id "$U" >/dev/null 2>&1; then
  if command -v useradd >/dev/null 2>&1; then useradd -m -s /bin/sh "$U"
  else adduser -D -s /bin/sh "$U"; fi
  CREATED=1
fi
if [ "$CREATED" = 1 ]; then
  # no usable password, but not "locked": OpenSSH without PAM refuses keys for locked accounts
  if command -v usermod >/dev/null 2>&1; then usermod -p '*' "$U"
  else sed -i "s/^$U:[^:]*:/$U:*:/" /etc/shadow; fi
fi

H=$(getent passwd "$U" 2>/dev/null | cut -d: -f6 || true)
[ -n "$H" ] || H=$(grep "^$U:" /etc/passwd | cut -d: -f6)
G=$(id -gn "$U")
mkdir -p "$H/.ssh"
touch "$H/.ssh/authorized_keys"
grep -qxF "$KEY" "$H/.ssh/authorized_keys" || printf '%s\n' "$KEY" >> "$H/.ssh/authorized_keys"
chown "$U:$G" "$H/.ssh" "$H/.ssh/authorized_keys"
chmod 700 "$H/.ssh"
chmod 600 "$H/.ssh/authorized_keys"

mkdir -p /usr/local/sbin
cat > /usr/local/sbin/tileops-read.new <<'TILEOPS_HELPER_EOF'
__HELPER__TILEOPS_HELPER_EOF
chown 0:0 /usr/local/sbin/tileops-read.new
chmod 755 /usr/local/sbin/tileops-read.new
mv /usr/local/sbin/tileops-read.new /usr/local/sbin/tileops-read

if command -v sudo >/dev/null 2>&1 && [ -d /etc/sudoers.d ]; then
  SS=$(command -v ss || true)
  SC=$(command -v systemctl || true)
  R="/usr/local/sbin/tileops-read crontabs, /usr/local/sbin/tileops-read authorized-keys"
  [ -n "$SS" ] && R="$R, $SS -tlnpH"
  if [ -n "$SC" ]; then
    for s in $SERVICES; do R="$R, $SC status --no-pager $s, $SC restart $s"; done
  fi
  T=/etc/sudoers.d/.tileops-$U.tmp
  printf 'Defaults:%s !requiretty\n%s ALL=(root) NOPASSWD: %s\n' "$U" "$U" "$R" > "$T"
  chmod 440 "$T"
  if visudo -cf "$T" >/dev/null 2>&1; then
    mv "$T" "/etc/sudoers.d/tileops-$U"
    echo "sudo rules installed: /etc/sudoers.d/tileops-$U"
  else
    rm -f "$T"
    echo "WARNING: sudoers check failed; TileOps will run in degraded (unprivileged) mode." >&2
  fi
else
  echo "NOTE: sudo is not installed; TileOps will run in degraded (unprivileged) mode."
fi

if command -v sshd >/dev/null 2>&1; then
  if sshd -T 2>/dev/null | grep -qiE '^(allowusers|allowgroups) '; then
    echo "WARNING: sshd has AllowUsers/AllowGroups; make sure '$U' is allowed to log in." >&2
  fi
fi

echo
echo "Host key fingerprints of this server (compare with the TileOps app):"
for f in /etc/ssh/ssh_host_*_key.pub; do [ -f "$f" ] && ssh-keygen -lf "$f" || true; done
echo
echo "TILEOPS SETUP OK"
